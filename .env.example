# GCP
GCP_PROJECT_ID=genomicflow-platform
GCP_REGION=europe-west2
GCP_ZONE=europe-west2-a

# Pub/Sub
PUBSUB_TOPIC_ID=genomic-events
PUBSUB_SUBSCRIPTION_ID=genomic-events-sub

# BigQuery
BQ_DATASET=genomicflow
BQ_TABLE_RUNS=sequencing_runs
BQ_TABLE_VARIANTS=variants
BQ_TABLE_QUALITY=quality_metrics

# GCS
GCS_RAW_BUCKET=genomicflow-raw
GCS_PROCESSED_BUCKET=genomicflow-processed

# App
LOG_LEVEL=INFO
ENVIRONMENT=development
APP_VERSION=0.1.0